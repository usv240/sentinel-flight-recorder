# SENTINEL — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — it contains real credentials.
#
# IMPORTANT — SENTINEL is honest about liveness. With NO credentials below it runs
# in "demo" posture: every response is tagged _live:false / _data_source:"demo"
# and is never presented as live. Check GET /api/health/integrations to see exactly
# which integrations are live vs demo, and what to wire to reach "fully_live".

# ── Gemini (required — primary LLM) ──────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/apikey
# PRIMARY: Gemini 3 (gemini-3-flash-preview) — reachable via API key only.
# FALLBACK: Gemini 2.5 (gemini-2.5-flash/pro) via Vertex AI, used automatically
#   if the Gemini 3 call fails (not-found / quota). The model that ACTUALLY ran
#   is reported in /api/health as gemini_model (vs gemini_model_configured).
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3-flash-preview

# ── Google Cloud (required for live data — BigQuery + Vertex AI fallback) ─────
# Without GOOGLE_PROJECT_ID, metrics come from labelled demo snapshots.
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us-central1
BIGQUERY_DATASET_PREFIX=google_sheets

# ── Fivetran MCP ──────────────────────────────────────────────────────────────
# Sign up: https://fivetran.com/signup (14-day free trial)
# API keys: Dashboard → Account Settings → API Keys
# Group ID: Dashboard → Groups → your group
FIVETRAN_API_KEY=your_fivetran_api_key
FIVETRAN_API_SECRET=your_fivetran_api_secret
FIVETRAN_GROUP_ID=your_fivetran_group_id
FIVETRAN_MCP_PATH=../fivetran-mcp/server.py
FIVETRAN_ALLOW_WRITES=true
# Optional — enables HMAC-SHA256 verification of inbound Fivetran webhooks.
# When set, POST /api/fivetran/webhook rejects unsigned/forged payloads with 401.
FIVETRAN_WEBHOOK_SECRET=your_fivetran_webhook_secret

# ── MongoDB Atlas (required — decision store) ─────────────────────────────────
# Create a free cluster at: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sentinel_db

# ── BigQuery Connector Registry ───────────────────────────────────────────────
# Register any Fivetran-connected BigQuery table here.
# Format: SENTINEL_BQ_{NAME}_TABLE=bigquery_dataset.table_name
# SENTINEL reads these at startup — no code changes needed.
SENTINEL_BQ_ACMESAAS_TABLE=google_sheets.acmesaas_metrics
# SENTINEL_BQ_SHOPIFY_TABLE=shopify.orders_daily
# SENTINEL_BQ_STRIPE_TABLE=stripe.subscription_metrics
# SENTINEL_BQ_HUBSPOT_TABLE=hubspot.contacts_engagement
# SENTINEL_BQ_SALESFORCE_TABLE=salesforce.opportunity_metrics

# ── Slack (optional — enables Decision Council + autonomous alerts) ────────────
# Create a Slack app at: https://api.slack.com/apps
# Required scopes: chat:write, channels:history, channels:read
# Events: message.channels (subscribe in your app settings)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-channel-id

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8101
OUTPUT_DIR=outputs/sentinel     # Use /tmp/sentinel on Cloud Run
