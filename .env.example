# ── Fivetran ──────────────────────────────────────────────────────────────────
# Sign up: https://fivetran.com/signup (14-day free trial)
# API key: Dashboard → Account Settings → API Keys
# Docs: https://fivetran.com/docs/rest-api/getting-started#authentication
FIVETRAN_API_KEY=your_fivetran_api_key
FIVETRAN_API_SECRET=your_fivetran_api_secret
FIVETRAN_GROUP_ID=your_fivetran_group_id

# MCP server path (clone from https://github.com/fivetran/fivetran-mcp)
FIVETRAN_MCP_PATH=../fivetran-mcp/server.py
FIVETRAN_ALLOW_WRITES=true

# ── MongoDB (reuse ORACLE cluster, new database) ───────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sentinel

# ── Google Cloud (reuse ORACLE project) ────────────────────────────────────────
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us-central1
BIGQUERY_DATASET_PREFIX=sentinel_

# ── Gemini via Vertex AI ────────────────────────────────────────────────────────
# Option A: API key (simpler)
GEMINI_API_KEY=your_gemini_api_key
# Option B: Service account (for Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── App ─────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
DEMO_MODE=true
